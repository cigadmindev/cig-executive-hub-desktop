# Mac signing/notarization — used by dist:mac, publish:mac, dist:all
APPLE_ID=your-apple-id-email@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=YOUR10CHARID

# GitHub — needed for publish:mac to actually upload the build to a Release
GH_TOKEN=your-github-personal-access-token
