rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /privacy-policy.html {
      allow read: if true;
      allow write: if false;
    }
    match /support-page.html {
      allow read: if true;
      allow write: if false;
    }
    // Read is open to any signed-in user because Storage rules can't reach
    // Firestore, so they can't tell who submitted or received a work order.
    // Per-order access is coming via signed URLs issued by a Cloud Function
    // that checks the work order document first. Until then, the limits below
    // at least stop arbitrary uploads and after-the-fact tampering.
    match /workOrders/{orderId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow update: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null;
    }
    // Permit and license documents, keyed by location and item so the
    // opening checklist and the renewal record can point at the same file —
    // a permit obtained during setup is the same permit that expires later.
    //
    // Read is open to signed-in users for the same reason as work orders:
    // Storage rules can't query Firestore, so they can't tell who has access
    // to a given location. The Phase 7b signed-URL work covers both.
    match /permitDocs/{locationId}/{itemKey}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null;
    }

    // Chat attachments. Deleted by a scheduled function once every member of
    // the conversation has viewed them — photos in a busy thread accumulate
    // faster than anyone notices, and the bill arrives quietly.
    //
    // Delete is denied to clients: only the sweep removes these, so a client
    // can't strip a file before others have seen it.
    // Two segments, not three: the file is uploaded before its message exists,
    // so there's no message id to key on yet. The conversation is enough for
    // the sweep to find everything it needs.
    match /chatAttachments/{conversationId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('application/.*document.*'));
      allow update, delete: if false;
    }

    // Profile photos. Keyed by uid, so someone can only write their own —
    // this is the one Storage path where the rule can check ownership, since
    // the uid is right there in the path.
    match /profilePhotos/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Expense receipts. Read is denied to every client, including finance
    // and admins - the only way to see one is a short-lived signed URL from
    // getReceiptUrls, which checks Firestore first. Storage rules cannot
    // read Firestore, so they cannot tell who is finance; rather than fall
    // back to 'any signed-in user' like workOrders and permitDocs do, this
    // path denies reads outright and puts the check where it can happen.
    //
    // Write is locked by path: the uid is in the path, so you can only ever
    // upload your own. No update, no delete - a submitted receipt is a
    // financial record, and the image behind it should not change after the
    // fact. The 90-day sweep removes images with the Admin SDK, which
    // ignores these rules.
    match /receipts/{uid}/{fileName} {
      allow read: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Daily expense reports. Same posture as the receipts themselves: no
    // client can read one directly. getExpenseReportUrl issues a short-lived
    // signed URL after checking the caller is an admin or job Financials -
    // the check Storage rules cannot make.
    //
    // Written and deleted only by the scheduled functions, using the Admin
    // SDK, which ignores these rules.
    match /expenseReports/{fileName} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}