rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /privacy-policy.html {
      allow read: if true;
      allow write: if false;
    }
    match /support-page.html {
      allow read: if true;
      allow write: if false;
    }
    // Read is open to any signed-in user because Storage rules can't reach
    // Firestore, so they can't tell who submitted or received a work order.
    // Per-order access is coming via signed URLs issued by a Cloud Function
    // that checks the work order document first. Until then, the limits below
    // at least stop arbitrary uploads and after-the-fact tampering.
    match /workOrders/{orderId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow update: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null;
    }
    // Permit and license documents, keyed by location and item so the
    // opening checklist and the renewal record can point at the same file —
    // a permit obtained during setup is the same permit that expires later.
    //
    // Read is open to signed-in users for the same reason as work orders:
    // Storage rules can't query Firestore, so they can't tell who has access
    // to a given location. The Phase 7b signed-URL work covers both.
    match /permitDocs/{locationId}/{itemKey}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null;
    }

    // Chat attachments. Deleted by a scheduled function once every member of
    // the conversation has viewed them — photos in a busy thread accumulate
    // faster than anyone notices, and the bill arrives quietly.
    //
    // Delete is denied to clients: only the sweep removes these, so a client
    // can't strip a file before others have seen it.
    // Two segments, not three: the file is uploaded before its message exists,
    // so there's no message id to key on yet. The conversation is enough for
    // the sweep to find everything it needs.
    match /chatAttachments/{conversationId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('application/.*document.*'));
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}