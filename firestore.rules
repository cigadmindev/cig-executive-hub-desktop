rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Here with the other shared helpers: rules resolve top to bottom, and
    // this was previously defined below the rules that use it.
    function myBrands() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.brandIds;
    }

    function isAdminOrExecutive() {
      return request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'executive');
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(resource) {
      return isSignedIn() && resource.data.authorUid == request.auth.uid;
    }
    // Restructuring a checklist - adding an item, deleting one, or putting
    // someone's name against it - belongs to the people responsible for what
    // is on the list: admins, the COO, and the beverage manager. Being an
    // executive is not the same as owning the checklist.
    //
    // Mirrors canEditChecklists in the app. If one changes, change both.
    function canEditChecklists() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.job == 'COO' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.job == 'Beverage Manager'
      );
    }

    // Finance is a job, not a role - Sam is an executive whose job is
    // Financials. There is no fourth role.
    function isCoo() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.job == 'COO';
    }

    function isFinance() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.job == 'Financials';
    }

    // Expense receipts. The only collection here where signed-in is not
    // enough to read - deliberately. Three tiers: you see your own, finance
    // and admins see everyone's, nobody else sees anything. Do not relax
    // this to match the collections around it.
    //
    // submittedByUid is set on create and can never change, so ownership
    // cannot be reassigned after the fact.
    // Daily expense report metadata - the label, totals, and whether it has
    // been collected. The file itself lives in Storage and is only reachable
    // through getExpenseReportUrl.
    //
    // Written by the scheduled function with the Admin SDK, so no client
    // write is permitted. Marking one downloaded also goes through a function,
    // because that is what deletes the file.
    // What a receipt can be charged to. Everyone reads it, because the
    // submission form offers it to whoever is filing the receipt. Only admins
    // maintain the list.
    // Same shape as expense receipts: you see your own, one job sees them all.
    // Job rather than person, so the routing follows whoever holds IT /
    // Training rather than a name.
    function handlesIntegrations() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.job == 'IT & Training'
      );
    }

    match /integrationRequests/{id} {
      allow read: if handlesIntegrations() ||
        (isSignedIn() && resource.data.createdByUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update: if handlesIntegrations();
      allow delete: if isAdmin();
    }

    // Saved starting points for a new login - role, job, folders and what
    // they can reach. Not restaurants or locations: those belong to the
    // person, not the role. Only admins create logins, so only admins need
    // these at all.
    // What to revoke when someone leaves, and what was removed so it can be
    // put back. Admins only - nobody else needs to know who is on their way out.
    // Written by the functions, read by the person they are for. Marking one
    // read is the only change anyone makes from the app.
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      // Only a record of your own action, about yourself, marked as such.
      // Anything sent to you is written by the functions, which these rules
      // do not apply to - so nobody can fake being told something.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.source == 'did';
      allow delete: if false;
    }

    // Whoever handles paying: finance, the owner, and admins.
    // Who decides on a new device: the COO and admins.
    function handlesDevices() {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return p.role == 'admin' || p.job == 'COO';
    }

    // The HR page: form links and contacts, kept here so a changed contact
    // or a moved folder does not need a deploy.
    match /appSettings/hr {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Who looks after catering and events at a location. Ann Marie should
    // not be reading Starkville's enquiries, and vice versa - the narrowing
    // within a restaurant is enforced in the app, as elsewhere.
    function eventsProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Looks after this side of things at a restaurant they have. One profile
    // read, since two in a single rule is enough to fail.
    function handlesEventsFor(brandId) {
      let p = eventsProfile();
      return (p.role == 'admin' || p.role == 'executive' || p.job == 'IT & Training')
        || ((p.job == 'General Manager' || p.job == 'Assistant Manager'
             || p.job == 'Executive Chef' || p.job == 'Sous Chef'
             || p.job == 'Catering & Events' || p.job == 'Kitchen Manager')
            && brandId in p.permissions.brandIds);
    }

    match /cateringEnquiries/{id} {
      allow read: if handlesEventsFor(resource.data.brandId);
      // Written by the function that reads the mailbox, and by anyone adding
      // one that came in by phone.
      allow create: if handlesEventsFor(request.resource.data.brandId);
      allow update: if handlesEventsFor(resource.data.brandId);
      allow delete: if isAdmin();
    }

    match /deviceRequests/{id} {
      allow read: if isAdminOrExecutive() || (isSignedIn() && resource.data.brandId in myBrands());
      // Raised as yourself, and always starting at the beginning.
      allow create: if (isAdminOrExecutive() || (isSignedIn() && request.resource.data.brandId in myBrands()))
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.status == 'requested';
      // Deciding and ordering belong to the COO and admins. Confirming it
      // turned up belongs to whoever asked - they are the only one who knows.
      allow update: if handlesDevices()
        || (isSignedIn() && resource.data.requestedByUid == request.auth.uid
            && resource.data.status == 'ordered'
            && request.resource.data.status == 'arrived'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'arrivedAt', 'arrivedByName']));
      allow delete: if isAdmin();
    }

    // Invoices were removed from the Hub on 6 October 2026. The old records
    // stay readable by admins; nothing can add to or change them.
    match /invoices/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /offboarding/{uid} {
      allow read, write: if isAdmin();
    }

    match /accessPresets/{id} {
      allow read, write: if isAdmin();
    }

    // Who sees what, by job - the admin's changes to the approved table.
    // Read by everyone, since every page checks it; changed by admins only.
    match /accessMatrix/{rowId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // What a receipt can be charged to. Finance and admins open, close and
    // reopen them.
    match /budgetTargets/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFinance();
    }

    // The fiscal calendar. Read by everyone so the receipt form can say which
    // period a receipt will land in; written only by the setup script.
    match /fiscalPeriods/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /expenseReports/{dateKey} {
      allow read: if isAdmin() || isFinance();
      allow write: if false;
    }

    match /expenseReceipts/{receiptId} {
      allow read: if isAdmin() || isFinance() ||
        (isSignedIn() && resource.data.submittedByUid == request.auth.uid);
      // Written only by submitExpenseReceipt, which stamps the deadline from
      // the server clock. A client create would let a device set its own.
      allow create: if false;
      // Editable by the person who submitted it until their cutoff passes -
      // the details only. The deadline, the void, the photo and who filed it
      // are not theirs to change, or a receipt could extend its own window
      // or un-void itself.
      allow update: if isSignedIn()
        && resource.data.submittedByUid == request.auth.uid
        && request.time.toMillis() < resource.data.editableUntil
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['amountCents', 'categoryKey', 'categoryLabel', 'where', 'reason',
                       'dateSpent', 'chargeToId', 'chargeToName']);
      // Admins can void a receipt but not delete it. Voiding stops it
      // counting toward totals and greys it out; the record survives, so a
      // daily report that already mentioned it still matches what is in the
      // app. Restricted to exactly those three fields so a void cannot be
      // used to quietly rewrite an amount.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['voided', 'voidedBy', 'voidedReason']);
      // A financial record is never removed from a client.
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pushToken', 'notifyEmail']))
        // Approving a request grants access, which is a permissions write.
        // Executives approve requests, so they may change a manager's
        // permissions - nothing else on the profile, and nobody else's.
        || (isAdminOrExecutive() && resource.data.role == 'manager'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissions']));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /categoryPosts/{postId} {
      allow read, update: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin() || isOwner(resource);
    }

    match /brandPosts/{postId} {
      // 'all' is a company-wide post; anything else is a restaurant.
      // 'all' is company-wide; a restaurant id; or a location, whose
      // restaurant is stored as brandId.
      allow read: if isAdminOrExecutive()
        || (isSignedIn() && (resource.data.targetId == 'all' || resource.data.targetId in myBrands()
            || resource.data.get('brandId', null) in myBrands()));
      // Likes and comments only - the post itself is the author's.
      allow update: if isAdmin() || isOwner(resource)
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'comments', 'timestamp']));
      allow create: if isSignedIn();
      allow delete: if isAdmin() || isOwner(resource);
    }

    match /accessRequests/{requestId} {
      // Yours, and the people who review them. A request carries the reason
      // someone gave for wanting access.
      allow read: if isAdminOrExecutive()
        || (isSignedIn() && resource.data.userEmail.lower() == request.auth.token.email.lower());
      allow create: if isSignedIn()
        && request.resource.data.userEmail.lower() == request.auth.token.email.lower()
        && request.resource.data.status == 'pending';
      // Only reviewers change these at all - a requester never edits one.
      allow update: if isAdmin()
        || (isAdminOrExecutive() && resource.data.userEmail.lower() != request.auth.token.email.lower());
      allow delete: if isAdmin();
    }

    match /schedules/{entryId} {
      // Every entry carries its restaurant, so reads are limited to the
      // restaurants someone has. Narrowing within a restaurant stays in the
      // app - a rule cannot check a location against the permissions map
      // without making every query unprovable.
      allow read: if isAdminOrExecutive() || (isSignedIn() && resource.data.brandId in myBrands());
      // Checklist items are restructuring - the three roles. A plain calendar
      // entry at a restaurant someone has is ordinary work.
      allow create: if canEditChecklists() || (
        isSignedIn() &&
        request.resource.data.openingItem != true &&
        request.resource.data.brandId in myBrands()
      );
      // Two branches, deliberately. The first is the three people who own the
      // list. The second is everyone else doing the actual work: ticking items
      // off, filling fields, attaching documents, moving a date.
      //
      // assignedToUid and assignedToName are absent from that second list on
      // purpose - otherwise anyone signed in could assign work to anybody by
      // writing the field directly.
      // Your own calendar entry, as long as it stays yours and stays at a
      // restaurant you have.
      allow update: if canEditChecklists() || (
        isSignedIn() &&
        resource.data.openingItem != true &&
        resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.brandId in myBrands()
      ) || (
        isSignedIn() &&
        resource.data.openingItem == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneBy', 'doneAt', 'signOffHistory', 'openingFields', 'dateTime', 'document'])
      );
      allow delete: if canEditChecklists() || (
        isSignedIn() &&
        resource.data.openingItem != true &&
        resource.data.authorUid == request.auth.uid
      );
    }

    // Chat is private to its members. Admins were able to read every
    // conversation, which is why the app used to warn people their messages
    // were not private. Both the oversight screens and that warning are gone,
    // so the rule matches what people are now told: only members can read.
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.memberUids;
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn();
      // The sender can edit their own message. Everyone in the conversation can
      // react and mark an attachment viewed — but only those fields, so a
      // member can't rewrite someone else's words on their way to adding a
      // thumbs up.
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.senderUid
        || (
          request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reactions', 'attachment'])
        )
      );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderUid || request.auth.uid in resource.data.memberUids || isAdmin());
    }

    // Time off carries reasons - "medical appointment", "funeral" - so it is
    // not roster information. Admins and executives review requests; everyone
    // else sees only their own. weeklyAvailability deliberately stays open:
    // who works which days is what the Team tab is for.
    // The fields that record a decision. Requesters can edit their own request
    // but never touch these - otherwise anyone could approve their own time
    // off, event, or request for a restaurant.
    function touchesReview() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['resolvedAt', 'resolvedByUid', 'denialReason']);
    }

    // Who sees the team's time off - the who-sees-what table's "Team" and up:
    // executives, General Managers and IT & Training. The app narrows a GM
    // to their own location.
    function seesTeam() {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return p.role == 'admin' || p.role == 'executive' || p.job == 'General Manager' || p.job == 'IT & Training';
    }

    match /timeOffRequests/{requestId} {
      allow read: if seesTeam() || (isSignedIn() && resource.data.uid == request.auth.uid);
      // Filed as yourself, and pending. It could be created already approved.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      // Decided by an admin, or an executive who is not the one asking.
      // The requester can edit their own, but the status can only ever be
      // pending in their hands and the decision fields stay untouched.
      // Decided by admins and the COO (who-sees-what table: Approve).
      allow update: if isAdmin()
        || (isCoo() && resource.data.uid != request.auth.uid)
        || (isSignedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending'
            && !touchesReview());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'denied');
    }

    match /weeklyAvailability/{uid} {
      // Your own hours, and whoever builds the schedule. Everyone could read
      // everyone's before.
      allow read: if seesTeam() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /customLocations/{locationId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    match /eventRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.status == 'pending';
      // Decided by admins and the COO (who-sees-what table: Approve).
      allow update: if isAdmin()
        || (isCoo() && resource.data.requestedByUid != request.auth.uid)
        || (isSignedIn() && resource.data.requestedByUid == request.auth.uid
            && request.resource.data.requestedByUid == request.auth.uid
            && request.resource.data.status == 'pending'
            && !touchesReview());
      allow delete: if isAdmin();
    }

    match /licenseRenewals/{itemId} {
      allow read: if isAdminOrExecutive() || (isSignedIn() && resource.data.brandId in myBrands());
      // Seeding runs as whoever opens the screen, so anyone must be able to
      // create the standard list - otherwise a manager opening a location
      // nobody senior has visited sees nothing.
      //
      // Adding a permit that is not in the template is restructuring, and
      // that is the three. The difference is the custom flag: seeding writes
      // false, the add form writes true.
      allow create: if isSignedIn() && (
        request.resource.data.custom != true || canEditChecklists()
      );
      // Two branches. The three can change anything. Everyone else can do the
      // work - set dates, attach the permit, sign it off - but not add
      // 'hidden' or 'custom', which are what take a permit off the list.
      allow update: if canEditChecklists() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['approvedDate', 'expirationDate', 'document', 'signedOffBy', 'signedOffAt'])
      );
      allow delete: if isAdmin();
    }

    match /viewTracking/{docId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Admins see everything, everyone else sees their own submissions.
    // This used to name one email address directly, which meant support
    // triage was tied to a single person and the unfiltered listener below
    // failed for everybody else - so nobody but that one account could see
    // their own reports.
    match /supportRequests/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.submitterUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Posting a support announcement is an admin action, not one person's.
    match /supportAnnouncements/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /openingLocationInfo/{locationId} {
      // Contractor, landlord and property manager details for a location.
      // Anyone with that restaurant; brandId is written with every change.
      allow read: if isAdminOrExecutive() || (isSignedIn() && resource.data.brandId in myBrands());
      allow create: if isAdminOrExecutive() || (isSignedIn() && request.resource.data.brandId in myBrands());
      allow update: if isAdminOrExecutive() || (isSignedIn() && request.resource.data.brandId in myBrands());
      allow delete: if isAdmin();
    }

    // Every contact carries the restaurant it belongs to, so reads can be
    // limited to the restaurants someone actually has. Before this, every
    // location's contacts sat in every browser.

    match /openingOngoingContacts/{id} {
      allow read: if isAdminOrExecutive() || (isSignedIn() && resource.data.brandId in myBrands());
      // Seeding writes the standard list as whoever opens the screen, so
      // create stays open to anyone with that restaurant.
      allow create: if isAdminOrExecutive() || (isSignedIn() && request.resource.data.brandId in myBrands());
      allow update: if isAdminOrExecutive() || (isSignedIn() && resource.data.brandId in myBrands());
      allow delete: if canEditChecklists();
    }

    match /openingOngoingContactsSeedMarker/{locationId} {
      allow read, create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /categoryDriveLinks/{id} {
      allow read: if isAdminOrExecutive() || (isSignedIn() && resource.data.brandId in myBrands());
      allow create, update: if isAdmin();
    }

    match /appSettings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /workOrders/{id} {
      // Signers, the sender, and admins. Everything else about a signed
      // document is between the people on it.
      allow read: if isAdmin()
        || (isSignedIn() && (request.auth.uid in resource.data.assignedUids
            || resource.data.uploadedByUid == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.uploadedByUid == request.auth.uid;
      // Signing, completing, and collecting your copy. downloadedByUids was
      // missing from this list, so recording a collection silently failed.
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.assignedUids || resource.data.uploadedByUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatures', 'status', 'completedAt', 'signedFileUrl', 'signedPdfError', 'filesDeleted', 'downloadedAt', 'downloadedBy', 'downloadedByUids']);
      allow delete: if isAdmin();
    }
  }
}