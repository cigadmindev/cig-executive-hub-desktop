rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The signed-in person's profile. Repeated get()s of this one document
    // count once per evaluation, so every helper can use it freely.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Signed in AND still active. A leaver's sign-in is disabled the moment
    // they are deactivated, but a token already issued keeps working for up
    // to an hour - so every rule checks the profile too (8 Oct 2026, S1).
    function isLive() {
      return request.auth != null && me().get('active', true) != false;
    }
    function isAdmin() {
      return isLive() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Here with the other shared helpers: rules resolve top to bottom, and
    // this was previously defined below the rules that use it.
    function myBrands() {
      return isLive() ? me().permissions.brandIds : [];
    }

    function isAdminOrExecutive() {
      return isLive() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'executive');
    }
    function isSignedIn() {
      return isLive();
    }
    function isOwner(resource) {
      return isSignedIn() && resource.data.authorUid == request.auth.uid;
    }
    // Restructuring a checklist - adding an item, deleting one, or putting
    // someone's name against it - belongs to the people responsible for what
    // is on the list: admins, and the rows marked Edit in Who sees what - the
    // COO, Culinary Director / Manager and Beverage Manager. Culinary was
    // missing here, so the page showed them the controls and then refused
    // the save (8 Oct 2026). Being an executive is not the same as owning the
    // checklist.
    //
    // Mirrors canEditChecklists in the app. If one changes, change both.
    function canEditChecklists() {
      return isLive() && (me().role == 'admin' || checklistLevel() == 'edit');
    }

    // The pre-opening checklist column of Who sees what, read live - so when
    // an admin changes a row in Manage Logins, the lock follows the screen
    // (8 Oct 2026). Before, the rule had its own fixed list of jobs, and a row
    // changed to Edit saw the buttons but had every save refused.
    //
    // Job -> row and the default levels mirror src/data/accessMatrix.js.
    // If a job or a row is added there, add it here too.
    function matrixRow() {
      return rowOf(me().get('job', ''));
    }
    function rowOf(job) {
      return {
        'Owner': 'owner', 'CEO': 'owner', 'COO': 'coo', 'Financials': 'financials',
        'Culinary Director': 'culinary', 'Culinary Manager': 'culinary', 'Beverage Manager': 'beverage',
        'General Manager': 'gm', 'Assistant Manager': 'agm', 'Kitchen Manager': 'km', 'Executive Chef': 'chef',
        'Sous Chef': 'sous', 'Catering & Events': 'catering', 'IT & Training': 'it', 'Marketing': 'marketing',
        'Communications': 'marketing', 'Videographer': 'video', 'HR': 'hr', 'Real Estate': 'realestate'
      }.get(job, 'none');
    }
    // The Daily checklists column (14 Oct 2026), read live like the
    // pre-opening one. Work: GMs, assistant managers and chefs by default.
    function dailyLevelFor(job) {
      let row = rowOf(job);
      let path = /databases/$(database)/documents/accessMatrix/$(row);
      let fallback = row in ['gm', 'agm', 'chef', 'sous'] ? 'work' : 'none';
      return exists(path) ? get(path).data.get('dailyChecklists', fallback) : fallback;
    }
    // Their own job's row, or their second job's (Cameron: also Starkville GM).
    function worksDailyLists() {
      return isLive() && (dailyLevelFor(me().get('job', '')) == 'work'
        || dailyLevelFor(me().get('alsoJob', {}).get('job', '')) == 'work');
    }
    function checklistDefault(row) {
      return {
        'owner': 'tick', 'coo': 'edit', 'financials': 'view', 'culinary': 'edit', 'beverage': 'edit',
        'km': 'tick', 'realestate': 'view'
      }.get(row, 'none');
    }
    function checklistLevel() {
      let row = matrixRow();
      let path = /databases/$(database)/documents/accessMatrix/$(row);
      return exists(path) ? get(path).data.get('openingChecklist', checklistDefault(row)) : checklistDefault(row);
    }
    // Tick items off: the rows at Tick or Edit, and admins.
    function canTickChecklists() {
      return isLive() && (me().role == 'admin' || checklistLevel() in ['tick', 'edit']);
    }

    // ---- Who sees what, read live (14 Oct 2026) ------------------------
    // Every column the rules depend on reads the table an admin edits in
    // Manage Logins, falling back to the approved defaults below - so a
    // changed cell changes what the database allows, not just the screen.
    // The defaults mirror src/data/accessMatrix.js ('*' = every other row).
    function colLevel(col, defaults) {
      let row = matrixRow();
      let path = /databases/$(database)/documents/accessMatrix/$(row);
      let fallback = defaults.get(row, defaults.get('*', 'none'));
      return exists(path) ? get(path).data.get(col, fallback) : fallback;
    }
    // Announcements: Post.
    function canPost() {
      return isLive() && (me().role == 'admin'
        || colLevel('announcements', { 'owner': 'post', 'coo': 'post', 'financials': 'post', 'culinary': 'post', 'beverage': 'post', 'it': 'post', '*': 'read' }) == 'post');
    }
    // Folders including Financials, or the folder given by an approved
    // access request.
    function seesFinancials() {
      let f = colLevel('folders', { 'owner': 'all', 'coo': 'all', 'financials': ['financials'], 'culinary': 'all', 'beverage': 'all', 'gm': 'all', 'it': 'all', '*': [] });
      return isLive() && (me().role == 'admin' || f == 'all' || (f is list && 'financials' in f)
        || 'financials' in me().get('permissions', {}).get('extraFolders', []));
    }
    // Device requests: View sees every request, Approve decides.
    function deviceLevel() {
      return colLevel('deviceRequests', { 'coo': 'approve', 'it': 'view', 'marketing': 'none', 'video': 'none', 'realestate': 'none', '*': 'ask' });
    }
    // Catering: View sees and adds at their places, Claim works them.
    function cateringLevel() {
      return colLevel('catering', { 'catering': 'claim', 'financials': 'none', 'marketing': 'none', 'video': 'none', 'hr': 'none', 'realestate': 'none', '*': 'view' });
    }
    // Availability: Team sees the team, Approve decides time off.
    function availabilityLevel() {
      return colLevel('availability', { 'coo': 'approve', 'owner': 'team', 'financials': 'team', 'culinary': 'team', 'beverage': 'team', 'gm': 'team', 'it': 'team', 'hr': 'team', 'marketing': 'none', 'video': 'none', 'realestate': 'none', '*': 'own' });
    }
    // Event requests: Approve decides.
    function eventsLevel() {
      return colLevel('eventRequests', { 'coo': 'approve', '*': 'ask' });
    }
    // Renewals: Full does the renewal work.
    function renewalsLevel() {
      return colLevel('renewals', { 'coo': 'full', 'gm': 'full', 'it': 'full', 'owner': 'view', 'culinary': 'view', 'beverage': 'view', 'agm': 'view', 'km': 'view', 'chef': 'view', 'realestate': 'view', '*': 'none' });
    }
    // Operational POC: Full fills in, adds and removes contacts.
    // A login switched to "assigned work only" (16 Oct 2026, Ben), on a record
    // that is assigned to them - by the list, or the older single field.
    function assignedHere(d) {
      return me().get('assignedWork', false) == true
        && (request.auth.uid in d.get('assignedToUids', []) || d.get('assignedToUid', '') == request.auth.uid);
    }
    function editsPoc() {
      return isLive() && (me().role == 'admin'
        || colLevel('operationalPoc', { 'coo': 'assign', 'culinary': 'full', 'beverage': 'full', 'gm': 'full', 'agm': 'full', 'sous': 'full', 'catering': 'full', 'it': 'full', '*': 'view' }) in ['full', 'assign']);
    }
    // Systems Help: Handle sees and works every request.
    function systemsLevel() {
      return colLevel('systemsHelp', { 'it': 'handle', '*': 'raise' });
    }

    // Finance is a job, not a role - Sam is an executive whose job is
    // Financials. There is no fourth role.
    function hasJob(job) {
      return isLive() && me().job == job;
    }

    function isCoo() {
      return isLive() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.job == 'COO';
    }

    function isFinance() {
      return isLive() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.job == 'Financials';
    }

    // Expense receipts. The only collection here where signed-in is not
    // enough to read - deliberately. Three tiers: you see your own, finance
    // and admins see everyone's, nobody else sees anything. Do not relax
    // this to match the collections around it.
    //
    // submittedByUid is set on create and can never change, so ownership
    // cannot be reassigned after the fact.
    // Daily expense report metadata - the label, totals, and whether it has
    // been collected. The file itself lives in Storage and is only reachable
    // through getExpenseReportUrl.
    //
    // Written by the scheduled function with the Admin SDK, so no client
    // write is permitted. Marking one downloaded also goes through a function,
    // because that is what deletes the file.
    // What a receipt can be charged to. Everyone reads it, because the
    // submission form offers it to whoever is filing the receipt. Only admins
    // maintain the list.
    // Same shape as expense receipts: you see your own, one job sees them all.
    // Job rather than person, so the routing follows whoever holds IT /
    // Training rather than a name.
    function handlesIntegrations() {
      return isLive() && (me().role == 'admin' || systemsLevel() == 'handle');
    }

    match /integrationRequests/{id} {
      allow read: if handlesIntegrations() ||
        (isSignedIn() && resource.data.createdByUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update: if handlesIntegrations();
      allow delete: if isAdmin();
    }

    // Saved starting points for a new login - role, job, folders and what
    // they can reach. Not restaurants or locations: those belong to the
    // person, not the role. Only admins create logins, so only admins need
    // these at all.
    // What to revoke when someone leaves, and what was removed so it can be
    // put back. Admins only - nobody else needs to know who is on their way out.
    // Written by the functions, read by the person they are for. Marking one
    // read is the only change anyone makes from the app.
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      // Only a record of your own action, about yourself, marked as such.
      // Anything sent to you is written by the functions, which these rules
      // do not apply to - so nobody can fake being told something.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.source == 'did';
      allow delete: if false;
    }

    // Whoever handles paying: finance, the owner, and admins.
    // Who decides on a new device: the COO and admins.
    function handlesDevices() {
      return isLive() && (me().role == 'admin' || deviceLevel() == 'approve');
    }

    // The HR page: form links and contacts, kept here so a changed contact
    // or a moved folder does not need a deploy.
    match /appSettings/hr {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // Benefits & insurance on the HR page (14 Oct 2026): executives and
    // admins only.
    match /appSettings/insurance {
      allow read: if isAdminOrExecutive();
      allow write: if isAdmin();
    }

    // Who looks after catering and events at a location. Ann Marie should
    // not be reading Starkville's enquiries, and vice versa - the narrowing
    // within a restaurant is enforced in the app, as elsewhere.
    function eventsProfile() {
      return me();
    }

    // Looks after this side of things at a restaurant they have. One profile
    // read, since two in a single rule is enough to fail.
    // The Catering column of Who sees what, read live (14 Oct 2026):
    // executives anywhere, everyone else at the restaurants on their login.
    function handlesEventsFor(brandId) {
      let p = eventsProfile();
      return isLive() && (p.role == 'admin'
        || (cateringLevel() in ['view', 'claim']
            && (p.role == 'executive' || brandId in p.get('permissions', {}).get('brandIds', []))));
    }

    // By location, not just restaurant (Brenner, 10 Oct 2026): someone whose
    // login is limited to some of a restaurant's locations sees only those -
    // Sarah (Starkville) never Ridgeland's, Ann Marie the reverse. Admins and
    // executives see every location; everyone else goes by their login.
    function eventsAtLocation(brandId, locationId) {
      let p = eventsProfile();
      let only = p.get('permissions', {}).get('locationsByBrand', {}).get(brandId, []);
      return p.role == 'admin' || p.role == 'executive'
        || only.size() == 0 || locationId in only;
    }

    match /cateringEnquiries/{id} {
      allow read: if handlesEventsFor(resource.data.brandId)
        && eventsAtLocation(resource.data.brandId, resource.data.locationId);
      // Written by the function that reads the mailbox, and by anyone adding
      // one that came in by phone.
      allow create: if handlesEventsFor(request.resource.data.brandId)
        && eventsAtLocation(request.resource.data.brandId, request.resource.data.locationId);
      // Claiming and working an enquiry is Catering & Events' alone, at their
      // own locations (Brenner, 10 Oct 2026); admins can correct anything.
      // Moving one to another of their restaurants (16 Oct 2026, Sarah):
      // where it ends up must be theirs too.
      allow update: if isAdmin() || (
        isLive() && cateringLevel() == 'claim'
        && resource.data.brandId in eventsProfile().get('permissions', {}).get('brandIds', [])
        && eventsAtLocation(resource.data.brandId, resource.data.locationId)
        && request.resource.data.brandId in eventsProfile().get('permissions', {}).get('brandIds', [])
        && eventsAtLocation(request.resource.data.brandId, request.resource.data.locationId));
      allow delete: if isAdmin();

      // What an event cost (10 Oct 2026): receipts added on the event, filed
      // to Expenses by the server when the event closes. Anyone who looks
      // after the event can see and add them; the person who added one can
      // take it off until it has been filed. Only the server marks it filed.
      match /costs/{costId} {
        function parent() {
          return get(/databases/$(database)/documents/cateringEnquiries/$(id)).data;
        }
        allow read: if handlesEventsFor(parent().brandId) && eventsAtLocation(parent().brandId, parent().locationId);
        allow create: if handlesEventsFor(parent().brandId) && eventsAtLocation(parent().brandId, parent().locationId)
          && request.resource.data.addedByUid == request.auth.uid
          && request.resource.data.filedReceiptId == null
          && request.resource.data.keys().hasOnly(['amountCents', 'accountCode', 'execCategory', 'where', 'storagePath', 'addedByUid', 'addedByName', 'addedAt', 'filedReceiptId'])
          && request.resource.data.amountCents is int && request.resource.data.amountCents > 0
          && request.resource.data.amountCents <= 100000000
          && request.resource.data.where is string && request.resource.data.where.size() >= 2
          && request.resource.data.storagePath is string
          && request.resource.data.storagePath.matches('receipts/' + request.auth.uid + '/.*');
        allow update: if false;
        allow delete: if isSignedIn() && resource.data.addedByUid == request.auth.uid && resource.data.filedReceiptId == null;
      }
    }

    match /deviceRequests/{id} {
      // The COO, admins and IT & Training see every request; everyone else
      // sees only their own.
      allow read: if isAdmin() || (isLive() && deviceLevel() in ['view', 'approve'])
        || (isSignedIn() && resource.data.requestedByUid == request.auth.uid);
      // Raised as yourself, and always starting at the beginning.
      allow create: if (isAdminOrExecutive() || (isSignedIn() && request.resource.data.brandId in myBrands()))
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.status == 'requested';
      // Deciding and ordering belong to the COO and admins. Confirming it
      // turned up belongs to whoever asked - they are the only one who knows.
      allow update: if handlesDevices()
        || (isSignedIn() && resource.data.requestedByUid == request.auth.uid
            && resource.data.status == 'ordered'
            && request.resource.data.status == 'arrived'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'arrivedAt', 'arrivedByName']));
      allow delete: if isAdmin();
    }

    // Invoices were removed from the Hub on 6 October 2026. The old records
    // stay readable by admins; nothing can add to or change them.
    match /invoices/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /offboarding/{uid} {
      allow read, write: if isAdmin();
    }

    match /accessPresets/{id} {
      allow read, write: if isAdmin();
    }

    // Daily opening and closing checklists. Read by anyone at that restaurant;
    // worked by the managers on duty (GMs and assistant managers). Signing
    // off and filing is done by the fileDailyChecklist function, which locks it.
    match /dailyChecklists/{id} {
      // A record that does not exist yet can be looked for - the page checks
      // before creating today's - which used to be refused (S10, 8 Oct).
      allow read: if isAdminOrExecutive()
        || (isSignedIn() && (resource == null || resource.data.brandId in myBrands()));
      // Ticked while open; locked while it is being filed and once filed.
      // Only the server moves it to "filing" and "filed".
      allow create, update: if (isAdmin()
        // The Daily checklists column (14 Oct 2026); the app narrows to their location.
        || (worksDailyLists() && request.resource.data.brandId in myBrands()))
        && (resource == null || resource.data.status == 'open')
        && request.resource.data.status == 'open';
      allow delete: if isAdmin();
    }

    // Who sees what, by job - the admin's changes to the approved table.
    // Read by everyone, since every page checks it; changed by admins only.
    match /accessMatrix/{rowId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Sam's accounts (9 Oct 2026), one document per account, id = its code.
    // Everyone who files receipts reads them; Finance and admins add or
    // retire them. A retired account stays on old receipts and reports.
    match /expenseAccounts/{code} {
      allow read: if isSignedIn();
      allow create, update: if (isAdmin() || isFinance())
        && request.resource.data.keys().hasOnly(['code', 'name', 'heading', 'headingOrder', 'order', 'retired', 'addedByName', 'addedAt', 'retiredByName', 'retiredAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.heading is string;
      allow delete: if false;
    }

    // Sam's entity numbers (12 Oct 2026): 100 Culinary Innovations Group,
    // 201 Taste Starkville... each tied to a Hub location ('corporate' for
    // 100). Read by everyone who files; looked after by Finance and admins.
    match /expenseEntities/{code} {
      allow read: if isSignedIn();
      allow create, update: if (isAdmin() || isFinance())
        && request.resource.data.keys().hasOnly(['code', 'name', 'locationId', 'order', 'retired', 'addedByName', 'addedAt'])
        && request.resource.data.code == code
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.locationId is string && request.resource.data.locationId.size() > 0;
      allow delete: if false;
    }
    // Each person's default entity, which their receipts start on. Set by
    // Finance and admins; the person reads their own.
    // My space (12 Oct 2026): notes, to-dos, the list of files and the
    // Drive folder link. Only the person it belongs to, and only while their
    // login has My space switched on - no admin branch, on purpose. The
    // Drive link is written by the server, which these rules do not cover.
    match /privateSpaces/{uid} {
      function mine() {
        return isLive() && request.auth.uid == uid && me().get('privateSpace', false) == true;
      }
      allow read: if mine();
      allow create: if mine() && request.resource.data.keys().hasOnly(['notes', 'notesUpdatedAt']);
      allow update: if mine() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'notesUpdatedAt']);
      allow delete: if false;
      match /{sub}/{id} {
        allow read, delete: if mine() && sub in ['todos', 'files'];
        allow create, update: if mine() && sub in ['todos', 'files'];
      }
    }

    match /expenseDefaults/{uid} {
      allow read: if isAdmin() || isFinance() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if (isAdmin() || isFinance())
        && request.resource.data.keys().hasOnly(['entityCode', 'setByName', 'setAt'])
        && request.resource.data.entityCode is string;
      allow delete: if isAdmin() || isFinance();
    }

    // The old charge-to list, replaced on 9 Oct 2026 by the Hub's own
    // locations (Corporate unless one is picked). Kept readable for history;
    // nothing writes to it any more.
    match /budgetTargets/{id} {
      allow read: if isAdmin() || isFinance();
      allow write: if false;
    }

    // The fiscal calendar. Read by everyone so the receipt form can say which
    // period a receipt will land in; written only by the setup script.
    match /fiscalPeriods/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /expenseReports/{dateKey} {
      allow read: if isAdmin() || isFinance();
      allow write: if false;
    }

    // Who sees a receipt (10 Oct 2026): the person who filed it; the COO,
    // for receipts filed from the restaurants and Catering & Events
    // (submitterLevel 'store', stamped by the server) - never an executive's;
    // Finance and admins, everything.
    match /expenseReceipts/{receiptId} {
      allow read: if isAdmin() || isFinance() ||
        (isSignedIn() && resource.data.submittedByUid == request.auth.uid) ||
        (isCoo() && resource.data.submitterLevel == 'store');
      // Every change goes through the server (9 Oct 2026): filing
      // (submitExpenseReceipt), your own edit or void until the period's
      // report is made (editExpenseReceipt, voidExpenseReceipt), Finance
      // giving it an account (recodeExpenseReceipt) or moving it to another
      // period (moveReceiptPeriod). Each checks who is asking and keeps a
      // record of what changed, so nothing here is written by a browser.
      allow create, update: if false;
      // A financial record is never removed from a client.
      allow delete: if false;
    }

    match /users/{userId} {
      // Your own profile stays readable after deactivation, so the app can
      // say "deactivated" rather than "no account".
      allow read: if isSignedIn() || (request.auth != null && request.auth.uid == userId);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pushToken', 'notifyEmail']));
      // Executives used to be able to change a manager's permissions, because
      // they approved access requests. Admins alone decide those now, so the
      // door is closed.
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /categoryPosts/{postId} {
      // Financials folder posts only for people with Financials (S5).
      allow read: if isSignedIn() && (resource.data.categoryId != 'financials' || seesFinancials());
      // The post is the author's. Likes and comments go through the server
      // (reactToPost), so nobody can change someone else's (S5).
      allow update: if isAdmin() || isOwner(resource);
      allow create: if canPost() && request.resource.data.authorUid == request.auth.uid
        && (request.resource.data.categoryId != 'financials' || seesFinancials());
      allow delete: if isAdmin() || isOwner(resource);
    }

    match /brandPosts/{postId} {
      // 'all' is a company-wide post; anything else is a restaurant.
      // 'all' is company-wide; a restaurant id; or a location, whose
      // restaurant is stored as brandId.
      allow read: if isAdminOrExecutive()
        || (isSignedIn() && (resource.data.targetId == 'all' || resource.data.targetId in myBrands()
            || resource.data.get('brandId', null) in myBrands()));
      // The post is the author's; likes and comments go through the server.
      allow update: if isAdmin() || isOwner(resource);
      // Only the rows that post, and always as yourself (S5).
      allow create: if canPost() && request.resource.data.authorUid == request.auth.uid;
      allow delete: if isAdmin() || isOwner(resource);
    }

    match /accessRequests/{requestId} {
      // Yours, and the people who review them. A request carries the reason
      // someone gave for wanting access.
      // Admins decide access requests (5 Oct 2026); executives no longer do.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userEmail.lower() == request.auth.token.email.lower());
      allow create: if isSignedIn()
        && request.resource.data.userEmail.lower() == request.auth.token.email.lower()
        && request.resource.data.status == 'pending';
      // Only admins change these at all - a requester never edits one.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // "Needs a signature from…" (10 Oct 2026). Someone working the list can
    // ask for a signature in their own name, or take a request off - never
    // mark one signed. Only the person asked signs it or sends it back, and
    // only while it is waiting on them.
    function signatureAskOk() {
      let after = request.resource.data.get('signature', null);
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['signature'])
        || after == null
        || (after.status == 'waiting' && after.requestedByUid == request.auth.uid);
    }
    function signerOk() {
      let before = resource.data.get('signature', null);
      let after = request.resource.data.get('signature', null);
      return before != null && before.status == 'waiting' && before.requestedOfUid == request.auth.uid
        && after != null && after.requestedOfUid == before.requestedOfUid && after.requestedByUid == before.requestedByUid
        && (after == before || after.status in ['signed', 'sentBack'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signature', 'done', 'doneBy', 'doneAt', 'signOffHistory', 'documents', 'document']);
    }

    match /schedules/{entryId} {
      // Every entry carries its restaurant, so reads are limited to the
      // restaurants someone has. Narrowing within a restaurant stays in the
      // app - a rule cannot check a location against the permissions map
      // without making every query unprovable.
      allow read: if isAdminOrExecutive() || (isSignedIn() && resource.data.brandId in myBrands());
      // Checklist items are restructuring - the three roles. A plain calendar
      // entry at a restaurant someone has is ordinary work.
      allow create: if canEditChecklists() || (
        isSignedIn() &&
        // .get with a default: an entry without the field (a confirmed
        // catering event, a plain calendar entry) is not an opening item.
        // Reading it directly refused the whole save (Sarah, 10 Oct 2026).
        request.resource.data.get('openingItem', false) != true &&
        request.resource.data.brandId in myBrands()
      );
      // Two branches, deliberately. The first is the three people who own the
      // list. The second is everyone else doing the actual work: ticking items
      // off, filling fields, attaching documents, moving a date.
      //
      // assignedToUid and assignedToName are absent from that second list on
      // purpose - otherwise anyone signed in could assign work to anybody by
      // writing the field directly.
      // Your own calendar entry, as long as it stays yours and stays at a
      // restaurant you have.
      allow update: if canEditChecklists() || (
        isSignedIn() &&
        resource.data.get('openingItem', false) != true &&
        resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.brandId in myBrands()
      ) || (
        // Ticking off, filling in, attaching a document or moving a date on a
        // pre-opening item: the rows at Tick or Edit (it was anyone signed
        // in, at any restaurant - S7, 8 Oct 2026) - and an assigned-work-only
        // login on an item assigned to them (16 Oct 2026, Ben).
        (canTickChecklists() || (isLive() && assignedHere(resource.data))) &&
        resource.data.get('openingItem', false) == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneBy', 'doneAt', 'signOffHistory', 'openingFields', 'dateTime', 'document', 'documents', 'signature']) &&
        signatureAskOk()
      ) || (
        // Renewing a permit ticks off its first-time calendar task (14 Oct
        // 2026) - whoever does renewals at that restaurant. Only the tick.
        isLive() && renewalsLevel() == 'full' &&
        resource.data.get('renewalItem', false) == true &&
        resource.data.brandId in myBrands() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneBy', 'doneAt'])
      ) || (
        // Catering & Events moving a confirmed event's date (14 Oct 2026) -
        // any catering entry at their restaurant, even one a colleague put
        // on the calendar. Only the date - or, when the event moves to another
        // of their restaurants (16 Oct 2026), its place.
        hasJob('Catering & Events') &&
        resource.data.get('openingItem', false) != true &&
        'Catering & Events' in resource.data.get('needs', []) &&
        resource.data.brandId in myBrands() &&
        request.resource.data.brandId in myBrands() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dateTime', 'locationId', 'brandId'])
      ) || (
        // The person asked to sign a finished item (10 Oct 2026): they sign it
        // (which ticks it off), send it back, or add the signed copy - even
        // if they could not otherwise tick this checklist.
        isSignedIn() &&
        resource.data.get('openingItem', false) == true &&
        signerOk()
      );
      allow delete: if canEditChecklists() || (
        isSignedIn() &&
        resource.data.get('openingItem', false) != true &&
        resource.data.authorUid == request.auth.uid
      ) || (
        // Catering & Events taking an event back off the calendar (14 Oct 2026).
        hasJob('Catering & Events') &&
        resource.data.get('openingItem', false) != true &&
        'Catering & Events' in resource.data.get('needs', []) &&
        resource.data.brandId in myBrands()
      );
    }

    // Chat is private to its members. Admins were able to read every
    // conversation, which is why the app used to warn people their messages
    // were not private. Both the oversight screens and that warning are gone,
    // so the rule matches what people are now told: only members can read.
    // A conversation, read from the database rather than trusted from the
    // message (S3, 8 Oct 2026).
    function convo(id) {
      return get(/databases/$(database)/documents/conversations/$(id)).data;
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      // Started by you, with you in it.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.createdBy == request.auth.uid;
      // Members only move the "last message" line and their own read marker -
      // nobody can add people, remove them, or rename it behind their backs.
      allow update: if isSignedIn() && request.auth.uid in resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessageText', 'lastMessageTimestamp', 'lastMessageSenderUid', 'lastReadTimestamps']);
      // Deleting it (and everyone's messages) is for whoever started it, or an admin.
      allow delete: if isAdmin() || (isSignedIn() && resource.data.get('createdBy', null) == request.auth.uid);
    }

    // A file on a message is stored as where it is, never as a download link -
    // a link works for anyone who has it (8 Oct 2026).
    function noFileLink() {
      return request.resource.data.get('attachment', null) == null
        || !('url' in request.resource.data.attachment)
        || request.resource.data.attachment.url == null;
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      // As yourself, into a conversation you are really in - checked against
      // the conversation itself. The message used to say who was in it, so
      // anyone could send into any chat, and anyone could be "told" about it
      // (S3, 8 Oct 2026).
      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.auth.uid in convo(request.resource.data.conversationId).memberUids
        && request.resource.data.memberUids == convo(request.resource.data.conversationId).memberUids
        && noFileLink();
      // The sender can edit their own message. Everyone in the conversation can
      // react and mark an attachment viewed — but only those fields, so a
      // member can't rewrite someone else's words on their way to adding a
      // thumbs up.
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.senderUid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['text', 'edited', 'reactions', 'attachment']))
        || (
          request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reactions', 'attachment'])
        )
      ) && noFileLink();
      // Your own message, or every message when whoever started the chat
      // deletes the whole conversation. Not anyone's in the group (S3).
      allow delete: if isAdmin() || (isSignedIn() && (request.auth.uid == resource.data.senderUid
        || convo(resource.data.conversationId).get('createdBy', null) == request.auth.uid));
    }

    // Time off carries reasons - "medical appointment", "funeral" - so it is
    // not roster information. Admins and executives review requests; everyone
    // else sees only their own. weeklyAvailability deliberately stays open:
    // who works which days is what the Team tab is for.
    // The fields that record a decision. Requesters can edit their own request
    // but never touch these - otherwise anyone could approve their own time
    // off, event, or request for a restaurant.
    function touchesReview() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['resolvedAt', 'resolvedByUid', 'denialReason']);
    }

    // Who sees the team's time off - the who-sees-what table's "Team" and up:
    // executives, General Managers and IT & Training. The app narrows a GM
    // to their own location.
    function seesTeam() {
      let p = me();
      // The rows marked Team or Approve for Availability in Who sees what
      // (S6/S8), and every executive - they see each other (10 Oct 2026).
      return isLive() && (p.role == 'admin' || p.role == 'executive' || availabilityLevel() in ['team', 'approve']);
    }

    match /timeOffRequests/{requestId} {
      allow read: if seesTeam() || (isSignedIn() && resource.data.uid == request.auth.uid);
      // Filed as yourself, and pending. It could be created already approved.
      // The reason goes in timeOffReasons, not here, where the team grid
      // would show it (S6).
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.get('reason', '') == '';
      // Decided by an admin, or an executive who is not the one asking.
      // The requester can edit their own, but the status can only ever be
      // pending in their hands and the decision fields stay untouched.
      // Decided by admins and the COO (who-sees-what table: Approve).
      allow update: if isAdmin()
        || (isLive() && availabilityLevel() == 'approve' && resource.data.uid != request.auth.uid)
        || (isSignedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.get('reason', '') == ''
            && !touchesReview());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'denied');
    }

    // Why someone is off: them, the COO and admins only (S6, 8 Oct). GMs and
    // the rest of the Team rows see the dates in timeOffRequests.
    // Executives' unavailable dates (14 Oct 2026): no approval. The executive
    // team and admins see them; each executive adds and removes their own.
    // Not IT & Training, Marketing or the videographer (matches
    // usesUnavailableDates in src/data/accessMatrix.js).
    function usesUnavailableDates() {
      return isLive() && me().role == 'executive' && !(matrixRow() in ['it', 'marketing', 'video']);
    }
    match /unavailableDates/{id} {
      allow read: if isAdminOrExecutive();
      allow create: if usesUnavailableDates()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.startDate is number
        && request.resource.data.endDate is number
        && request.resource.data.endDate >= request.resource.data.startDate;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /timeOffReasons/{requestId} {
      allow read: if isAdmin() || (isLive() && availabilityLevel() == 'approve') || (isSignedIn() && resource.data.uid == request.auth.uid);
      // Your own reason, on your own request. The reason is saved just before
      // the request (so the email about it can include it), so a request
      // that doesn't exist yet is fine; one that exists must be yours.
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid)
        && (!exists(/databases/$(database)/documents/timeOffRequests/$(requestId))
          || get(/databases/$(database)/documents/timeOffRequests/$(requestId)).data.uid == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /weeklyAvailability/{uid} {
      // Your own hours, and whoever builds the schedule. Everyone could read
      // everyone's before.
      allow read: if seesTeam() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /customLocations/{locationId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    match /eventRequests/{requestId} {
      // Private (S6, 8 Oct): whoever asked, and the COO and admins who decide.
      allow read: if isAdmin() || (isLive() && eventsLevel() == 'approve')
        || (isSignedIn() && resource.data.requestedByUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.status == 'pending';
      // Decided by admins and the COO (who-sees-what table: Approve).
      allow update: if isAdmin()
        || (isLive() && eventsLevel() == 'approve' && resource.data.requestedByUid != request.auth.uid)
        || (isSignedIn() && resource.data.requestedByUid == request.auth.uid
            && request.resource.data.requestedByUid == request.auth.uid
            && request.resource.data.status == 'pending'
            && !touchesReview());
      allow delete: if isAdmin();
    }

    match /licenseRenewals/{itemId} {
      allow read: if isAdminOrExecutive() || (isSignedIn() && resource.data.brandId in myBrands());
      // Seeding runs as whoever opens the screen, so anyone must be able to
      // create the standard list - otherwise a manager opening a location
      // nobody senior has visited sees nothing.
      //
      // Adding a permit that is not in the template is restructuring, and
      // that is the three. The difference is the custom flag: seeding writes
      // false, the add form writes true.
      allow create: if isSignedIn() && (
        request.resource.data.custom != true || canEditChecklists()
      );
      // Two branches. The three can change anything. Everyone else can do the
      // work - set dates, attach the permit, sign it off - but not add
      // 'hidden' or 'custom', which are what take a permit off the list.
      // Since 14 Oct 2026: the Renewals column at Full, at a restaurant they
      // have (it was anyone signed in, anywhere).
      allow update: if canEditChecklists() || (
        isLive() && renewalsLevel() == 'full'
        && (isAdminOrExecutive() || resource.data.brandId in myBrands()) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['approvedDate', 'expirationDate', 'document', 'signedOffBy', 'signedOffAt'])
      );
      allow delete: if isAdmin();
    }

    match /viewTracking/{docId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Admins see everything, everyone else sees their own submissions.
    // This used to name one email address directly, which meant support
    // triage was tied to a single person and the unfiltered listener below
    // failed for everybody else - so nobody but that one account could see
    // their own reports.
    match /supportRequests/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.submitterUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Posting a support announcement is an admin action, not one person's.
    match /supportAnnouncements/{id} {
      // An update sent to everyone, or to you by name; admins see them all.
      // It used to be readable by anyone signed in, whoever it was for (B1.1).
      allow read: if isAdmin() || (isSignedIn() && (resource.data.visibleToAll == true
        || request.auth.uid in resource.data.visibleToUids));
      allow create: if isAdmin();
      // Admins only; likes and replies go through the server (S5).
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Your private reply to an update on the Support page: you and admins
    // only. Replies used to sit inside the update itself, where anyone who
    // could read the update could read every reply (B1.1, 8 Oct 2026).
    // Written only by the server (reactToPost).
    match /supportReplies/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /openingLocationInfo/{locationId} {
      // Contractor, landlord and property manager details for a location.
      // Anyone with that restaurant; brandId is written with every change.
      allow read: if isAdminOrExecutive() || (isSignedIn() && resource.data.brandId in myBrands());
      // "Checked for this area" (16 Oct 2026) is set and cleared by admins only.
      allow create: if (isAdminOrExecutive() || (isSignedIn() && request.resource.data.brandId in myBrands()))
        && (isAdmin() || !request.resource.data.keys().hasAny(['checkedForArea']));
      allow update: if (isAdminOrExecutive() || (isSignedIn() && request.resource.data.brandId in myBrands()))
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['checkedForArea']));
      allow delete: if isAdmin();
    }

    // Every contact carries the restaurant it belongs to, so reads can be
    // limited to the restaurants someone actually has. Before this, every
    // location's contacts sat in every browser.

    match /openingOngoingContacts/{id} {
      allow read: if isAdminOrExecutive() || (isSignedIn() && resource.data.brandId in myBrands());
      // Seeding writes the standard list as whoever opens the screen, so
      // create stays open to anyone with that restaurant.
      allow create: if (isAdminOrExecutive() || (isSignedIn() && request.resource.data.brandId in myBrands()))
        && !request.resource.data.keys().hasAny(['assignedToUid', 'assignedToName', 'assignedToUids', 'assignedToNames', 'assignedByName', 'assignedAt']);
      // Filling in and removing: Full on the Operational POC column, read
      // live (14 Oct 2026). GMs, assistant managers, Shannon, Ronnie, Bobbie.
      // Who a contact is assigned to is set only by the server
      // (assignPocContacts, 15 Oct 2026), so nobody can hand work to
      // someone else from the browser.
      allow update: if (editsPoc() && (isAdminOrExecutive() || resource.data.brandId in myBrands())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedToUid', 'assignedToName', 'assignedToUids', 'assignedToNames', 'assignedByName', 'assignedAt']))
        // Assigned work only (16 Oct 2026, Ben): fills in a contact given to
        // him, and nothing else about it.
        || (isLive() && assignedHere(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['who', 'vendor', 'contactNameNumber', 'accountNumber']));
      allow delete: if editsPoc() && (isAdminOrExecutive() || resource.data.brandId in myBrands());
    }

    match /openingOngoingContactsSeedMarker/{locationId} {
      allow read, create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /categoryDriveLinks/{id} {
      allow read: if isAdminOrExecutive() || (isSignedIn() && resource.data.brandId in myBrands());
      allow create, update: if isAdmin();
    }

    match /appSettings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /workOrders/{id} {
      // Signers, the sender, and admins. Everything else about a signed
      // document is between the people on it.
      allow read: if isAdmin()
        || (isSignedIn() && (request.auth.uid in resource.data.assignedUids
            || resource.data.uploadedByUid == request.auth.uid));
      // A new document starts unsigned, with its file (if any) in its own
      // folder. The signed copy and its path are written only by the server
      // (S2, 8 Oct): a client could otherwise point a record at any file.
      allow create: if isSignedIn() && request.resource.data.uploadedByUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.signatures.size() == 0
        && request.resource.data.get('completedAt', null) == null
        && request.resource.data.get('signedPath', null) == null
        && request.resource.data.get('signedFileUrl', null) == null
        && request.resource.data.get('originalFileUrl', null) == null
        && (request.resource.data.get('originalPath', null) == null
            || request.resource.data.originalPath.matches('workOrders/' + id + '/original-[^/]+'));
      // Signing, completing, and collecting your copy.
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.assignedUids || resource.data.uploadedByUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatures', 'status', 'completedAt', 'filesDeleted', 'downloadedAt', 'downloadedBy', 'downloadedByUids']);
      allow delete: if isAdmin();
    }
  }
}